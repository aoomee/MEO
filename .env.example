# Copy to .env and replace every value marked CHANGE_ME.
MMWX_PORT=12889
MMWX_TZ=Asia/Shanghai
# Optional HMAC signing secret. Random opaque sessions remain secure when omitted.
MMWX_JWT_SECRET=

# Optional: enable panel/Agent updates from your private GitHub Releases.
# Format: owner/repository. Keep these empty to disable online updates.
MMWX_UPDATE_REPO=
MMWX_AGENT_GITHUB_REPO=
MMWX_GH_TOKEN=

# PostgreSQL override (used with deploy/compose.postgres.yml).
POSTGRES_DB=mmwx
POSTGRES_USER=mmwx
POSTGRES_PASSWORD=CHANGE_ME_TO_A_DATABASE_PASSWORD
